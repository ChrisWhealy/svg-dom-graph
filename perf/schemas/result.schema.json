{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svg-dom-graph:perf:result:1",
  "title": "One repetition of one workload in one mode",
  "description": "A single run. It holds no between-run statistic and no confidence interval, because one run has neither. Those belong to the comparison schema, which reads a collection of these.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_position": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["browser", "native"],
          "description": "browser: a run in a browser, which names it. native: a run of native code, such as the Layer A runner, which has no browser."
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)+$"
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "runner_class": {
          "type": "string",
          "minLength": 1
        },
        "timer_resolution_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cross_origin_isolated": {
          "type": "boolean"
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "rustc": {
          "type": "string"
        },
        "wasm_pack": {
          "type": "string"
        },
        "crate_version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "build_profile": {
          "type": "string",
          "minLength": 1,
          "description": "How the code under test was built, for example release."
        }
      },
      "required": [
        "kind",
        "os",
        "cpu",
        "runner_class",
        "timer_resolution_us",
        "protocol_version",
        "crate_version",
        "git_sha",
        "git_dirty"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "browser"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["browser", "browser_version", "cross_origin_isolated"]
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Of the stream that was executed, over the scope named beside it. It must equal the workload report's digest for that scope."
        },
        "canonical": {
          "$ref": "urn:svg-dom-graph:perf:manifest:1"
        },
        "operation_stream_scope": {
          "enum": ["full", "mutations"],
          "description": "Which digest of the workload report this run executed: every operation, or the mutations alone. A correctness run executes the full stream, and a performance run skips the checkpoints and executes the mutations."
        }
      },
      "required": ["id", "sha256", "operation_stream_scope", "operation_stream_sha256", "canonical"],
      "additionalProperties": false
    },
    "mode": {
      "enum": ["correctness", "performance", "recovery", "endurance"]
    },
    "status": {
      "enum": ["ok", "invalid_incorrect", "refused", "timed_out", "error"]
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": ["A", "B", "C"]
          },
          "status": {
            "enum": ["measured", "unavailable", "measurement_error"]
          },
          "unit": {
            "enum": ["ms", "us", "count", "bytes"]
          },
          "kind": {
            "enum": ["latency", "batch_throughput", "count", "trend", "capacity"],
            "description": "capacity is the high-water mark of a resource that is not handed back, such as wasm linear memory. It says how much was ever needed. It is not live usage, and growth in it is not by itself a leak."
          },
          "batch_size": {
            "type": "integer",
            "minimum": 2
          },
          "samples": {
            "type": "integer",
            "minimum": 1
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "outliers_flagged": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "p50": {
                "type": "number"
              },
              "p95": {
                "type": "number"
              },
              "p99": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": ["min", "p50", "max"],
            "additionalProperties": false
          },
          "within_run": {
            "type": "object",
            "properties": {
              "mean": {
                "type": "number"
              },
              "stddev": {
                "type": "number",
                "minimum": 0
              },
              "iqr": {
                "type": "number",
                "minimum": 0
              },
              "tukey_low": {
                "type": "number"
              },
              "tukey_high": {
                "type": "number"
              }
            },
            "required": ["mean", "stddev", "iqr", "tukey_low", "tukey_high"],
            "additionalProperties": false
          },
          "value": {
            "type": "number"
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "resolution_limited": {
            "const": true,
            "description": "The typical value is under 50 timer steps and was not batched, so the figure is quantised and must not be compared finely."
          }
        },
        "required": ["name", "layer", "status"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                }
              }
            },
            "then": {
              "required": ["unit", "kind", "mechanism"],
              "not": {
                "required": ["reason"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["unavailable", "measurement_error"]
                }
              }
            },
            "then": {
              "required": ["reason"],
              "not": {
                "anyOf": [
                  {
                    "required": ["summary"]
                  },
                  {
                    "required": ["value"]
                  },
                  {
                    "required": ["samples"]
                  },
                  {
                    "required": ["within_run"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "enum": ["latency", "batch_throughput"]
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "required": ["samples", "summary", "within_run", "dropped", "outliers_flagged"],
              "properties": {
                "unit": {
                  "enum": ["ms", "us"]
                }
              },
              "not": {
                "required": ["value"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "const": "batch_throughput"
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "required": ["batch_size"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "enum": ["count", "trend", "capacity"]
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "required": ["value"],
              "properties": {
                "unit": {
                  "enum": ["count", "bytes"]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": ["summary"]
                  },
                  {
                    "required": ["batch_size"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "latency"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "not": {
                "required": ["batch_size"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "const": "capacity"
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "bytes"
                }
              }
            }
          },
          {
            "if": {
              "required": ["resolution_limited"]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "latency"
                },
                "unit": {
                  "const": "us"
                }
              },
              "required": ["kind", "unit"]
            }
          }
        ]
      }
    },
    "checkpoints_passed": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoints_failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "enum": ["topology", "dom_identity", "geometry", "content", "interaction", "accessibility", "paint_order"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["section", "detail"],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "description": "What a recovery run saw at a fault point that nothing documents. It is a finding and not a pass or a failure, since the library promises nothing there to test against.",
      "items": {
        "type": "object",
        "properties": {
          "point": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "const": "undocumented"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        },
        "required": ["point", "contract", "summary", "details"],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "string",
      "minLength": 1,
      "description": "The file that holds one row for each failure that a recovery run injected."
    },
    "raw_samples": {
      "type": "string",
      "minLength": 1
    },
    "injection": {
      "type": "object",
      "description": "Present only on a run of a candidate that was changed on purpose, to prove that a comparison or a gate notices the change. Such a run is never a baseline.",
      "properties": {
        "slowdown_us": {
          "type": "number",
          "minimum": 0,
          "description": "Microseconds spent inside the timed interval after every library call of a node, an edge or a move."
        },
        "leak": {
          "enum": ["none", "bytes", "closure", "library_watch"],
          "description": "What is leaked after every teardown."
        }
      },
      "required": ["slowdown_us", "leak"],
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "description": "Deterministic checks that the run made of itself, such as that live memory does not keep growing. inconclusive is never a pass.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["pass", "fail", "inconclusive"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "status", "detail"],
        "additionalProperties": false
      }
    },
    "simulation": {
      "type": "object",
      "description": "What workload W6 ran, and whether it was allowed to be timed: the generator's revision and seed, the activity and stability figures of the trace's windows, the counts of the whole trace (a pop is a popped heap event, stale ones included), and the three hashes that stay separate. A refused trace has all of it and no time series, since a refusal is a record and not a pass.",
      "properties": {
        "generator_revision": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "qualification": {
          "type": "object",
          "properties": {
            "qualified": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Why the trace was refused. Empty if it qualified."
            },
            "metrics": {
              "type": ["object", "null"],
              "description": "The six figures that the bounds apply to, null if the measured window does not exist.",
              "properties": {
                "occupancyMean": {
                  "type": "number"
                },
                "waitingNonemptyFraction": {
                  "type": "number"
                },
                "popsPerSlice": {
                  "type": "number"
                },
                "busyFraction": {
                  "type": "number"
                },
                "halfOccupancyDifference": {
                  "type": "number"
                },
                "halfPopsDifference": {
                  "type": "number"
                }
              },
              "required": [
                "occupancyMean",
                "waitingNonemptyFraction",
                "popsPerSlice",
                "busyFraction",
                "halfOccupancyDifference",
                "halfPopsDifference"
              ],
              "additionalProperties": false
            },
            "occupancy_histogram": {
              "type": ["array", "null"],
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "How many slices of the measured window ended with each waiting count, from 0 to the queue capacity."
            },
            "measured_window": {
              "type": ["object", "null"],
              "properties": {
                "slices": {
                  "type": "integer",
                  "minimum": 1
                },
                "occupancy_mean": {
                  "type": "number"
                },
                "waiting_nonempty_fraction": {
                  "type": "number"
                },
                "pops_per_slice": {
                  "type": "number"
                },
                "busy_fraction": {
                  "type": "number"
                }
              },
              "required": ["slices", "occupancy_mean", "waiting_nonempty_fraction", "pops_per_slice", "busy_fraction"],
              "additionalProperties": false
            },
            "interactive_window": {
              "type": ["object", "null"],
              "properties": {
                "slices": {
                  "type": "integer",
                  "minimum": 1
                },
                "occupancy_mean": {
                  "type": "number"
                },
                "waiting_nonempty_fraction": {
                  "type": "number"
                },
                "pops_per_slice": {
                  "type": "number"
                },
                "busy_fraction": {
                  "type": "number"
                }
              },
              "required": ["slices", "occupancy_mean", "waiting_nonempty_fraction", "pops_per_slice", "busy_fraction"],
              "additionalProperties": false
            },
            "minimums": {
              "type": "object",
              "properties": {
                "slices": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "actual": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "met": {
                      "type": "boolean"
                    }
                  },
                  "required": ["required", "actual", "met"],
                  "additionalProperties": false
                },
                "pops": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "actual": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "met": {
                      "type": "boolean"
                    }
                  },
                  "required": ["required", "actual", "met"],
                  "additionalProperties": false
                }
              },
              "required": ["slices", "pops"],
              "additionalProperties": false
            },
            "bounds": {
              "type": "object"
            },
            "generator_revision": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "generator_revision",
            "seed",
            "qualified",
            "reasons",
            "metrics",
            "occupancy_histogram",
            "measured_window",
            "interactive_window",
            "minimums",
            "bounds"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "arrivals": {
              "type": "integer",
              "minimum": 0
            },
            "pops": {
              "type": "integer",
              "minimum": 0
            },
            "stale_pops": {
              "type": "integer",
              "minimum": 0
            },
            "noop_pops": {
              "type": "integer",
              "minimum": 0
            },
            "slices": {
              "type": "integer",
              "minimum": 0
            },
            "stale_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pops_per_slice": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["arrivals", "pops", "stale_pops", "noop_pops", "slices", "stale_fraction", "pops_per_slice"],
          "additionalProperties": false
        },
        "hashes": {
          "type": "object",
          "properties": {
            "input_stream_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "event_pop_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "checkpoint_chain_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["input_stream_sha256", "event_pop_sha256", "checkpoint_chain_sha256"],
          "additionalProperties": false
        }
      },
      "required": ["generator_revision", "seed", "qualification", "counts", "hashes"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "repetition",
    "environment",
    "manifest",
    "mode",
    "status",
    "metrics"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["refused", "timed_out", "error"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["error"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "required": ["error"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_incorrect"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["checkpoints_failed"],
        "properties": {
          "checkpoints_failed": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "correctness"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["checkpoints_passed", "checkpoints_failed"]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": ["performance", "endurance"]
          },
          "status": {
            "const": "ok"
          }
        },
        "required": ["mode", "status"]
      },
      "then": {
        "required": ["raw_samples"]
      }
    }
  ]
}
