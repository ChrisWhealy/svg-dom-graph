{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svg-dom-graph:perf:result:1",
  "title": "One repetition of one workload in one mode",
  "description": "A single run. It holds no between-run statistic and no confidence interval, because one run has neither. Those belong to the comparison schema, which reads a collection of these.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_position": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["browser", "native"],
          "description": "browser: a run in a browser, which names it. native: a run of native code, such as the Layer A runner, which has no browser."
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)+$"
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "runner_class": {
          "type": "string",
          "minLength": 1
        },
        "timer_resolution_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cross_origin_isolated": {
          "type": "boolean"
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "rustc": {
          "type": "string"
        },
        "wasm_pack": {
          "type": "string"
        },
        "crate_version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "build_profile": {
          "type": "string",
          "minLength": 1,
          "description": "How the code under test was built, for example release."
        }
      },
      "required": [
        "kind",
        "os",
        "cpu",
        "runner_class",
        "timer_resolution_us",
        "protocol_version",
        "crate_version",
        "git_sha",
        "git_dirty"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "browser"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["browser", "browser_version", "cross_origin_isolated"]
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Of the stream that was executed, over the scope named beside it. It must equal the workload report's digest for that scope."
        },
        "canonical": {
          "$ref": "urn:svg-dom-graph:perf:manifest:1"
        },
        "operation_stream_scope": {
          "enum": ["full", "mutations"],
          "description": "Which digest of the workload report this run executed: every operation, or the mutations alone. A correctness run executes the full stream, and a performance run skips the checkpoints and executes the mutations."
        }
      },
      "required": [
        "id",
        "sha256",
        "operation_stream_scope",
        "operation_stream_sha256",
        "canonical"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": ["correctness", "performance", "recovery", "endurance"]
    },
    "status": {
      "enum": ["ok", "invalid_incorrect", "refused", "timed_out", "error"]
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": ["A", "B", "C"]
          },
          "status": {
            "enum": ["measured", "unavailable", "measurement_error"]
          },
          "unit": {
            "enum": ["ms", "us", "count", "bytes"]
          },
          "kind": {
            "enum": [
              "latency",
              "batch_throughput",
              "count",
              "trend",
              "capacity"
            ],
            "description": "capacity is the high-water mark of a resource that is not handed back, such as wasm linear memory. It says how much was ever needed. It is not live usage, and growth in it is not by itself a leak."
          },
          "batch_size": {
            "type": "integer",
            "minimum": 2
          },
          "samples": {
            "type": "integer",
            "minimum": 1
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "outliers_flagged": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "p50": {
                "type": "number"
              },
              "p95": {
                "type": "number"
              },
              "p99": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": ["min", "p50", "max"],
            "additionalProperties": false
          },
          "within_run": {
            "type": "object",
            "properties": {
              "mean": {
                "type": "number"
              },
              "stddev": {
                "type": "number",
                "minimum": 0
              },
              "iqr": {
                "type": "number",
                "minimum": 0
              },
              "tukey_low": {
                "type": "number"
              },
              "tukey_high": {
                "type": "number"
              }
            },
            "required": ["mean", "stddev", "iqr", "tukey_low", "tukey_high"],
            "additionalProperties": false
          },
          "value": {
            "type": "number"
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "resolution_limited": {
            "const": true,
            "description": "The typical value is under 50 timer steps and was not batched, so the figure is quantised and must not be compared finely."
          }
        },
        "required": ["name", "layer", "status"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                }
              }
            },
            "then": {
              "required": ["unit", "kind", "mechanism"],
              "not": {
                "required": ["reason"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["unavailable", "measurement_error"]
                }
              }
            },
            "then": {
              "required": ["reason"],
              "not": {
                "anyOf": [
                  {
                    "required": ["summary"]
                  },
                  {
                    "required": ["value"]
                  },
                  {
                    "required": ["samples"]
                  },
                  {
                    "required": ["within_run"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "enum": ["latency", "batch_throughput"]
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "required": [
                "samples",
                "summary",
                "within_run",
                "dropped",
                "outliers_flagged"
              ],
              "properties": {
                "unit": {
                  "enum": ["ms", "us"]
                }
              },
              "not": {
                "required": ["value"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "const": "batch_throughput"
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "required": ["batch_size"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "enum": ["count", "trend", "capacity"]
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "required": ["value"],
              "properties": {
                "unit": {
                  "enum": ["count", "bytes"]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": ["summary"]
                  },
                  {
                    "required": ["batch_size"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "latency"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "not": {
                "required": ["batch_size"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "measured"
                },
                "kind": {
                  "const": "capacity"
                }
              },
              "required": ["status", "kind"]
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "bytes"
                }
              }
            }
          },
          {
            "if": {
              "required": ["resolution_limited"]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "latency"
                },
                "unit": {
                  "const": "us"
                }
              },
              "required": ["kind", "unit"]
            }
          }
        ]
      }
    },
    "checkpoints_passed": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoints_failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "enum": [
              "topology",
              "dom_identity",
              "geometry",
              "content",
              "interaction",
              "accessibility",
              "paint_order"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["section", "detail"],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "raw_samples": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "repetition",
    "environment",
    "manifest",
    "mode",
    "status",
    "metrics"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["refused", "timed_out", "error"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["error"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "required": ["error"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_incorrect"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["checkpoints_failed"],
        "properties": {
          "checkpoints_failed": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "correctness"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["checkpoints_passed", "checkpoints_failed"]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": ["performance", "endurance"]
          },
          "status": {
            "const": "ok"
          }
        },
        "required": ["mode", "status"]
      },
      "then": {
        "required": ["raw_samples"]
      }
    }
  ]
}
