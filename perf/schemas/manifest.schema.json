{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svg-dom-graph:perf:manifest:1",
  "title": "A workload manifest, as TOML converts to JSON",
  "description": "manifest.example.toml is an annotated instance. A result carries a complete copy of the manifest it ran. Unknown keys are rejected, so a misspelt option cannot be silently ignored.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workload": {
      "enum": ["scene_construction", "connector_rerouting", "scene_lifecycle"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "prng": {
      "const": "splitmix64"
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_degree": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["nodes"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": ["correctness", "performance", "recovery", "endurance"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "warmup_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "enum": ["sequential", "interleaved"]
        }
      },
      "required": [
        "modes",
        "warmup_iterations",
        "measurement_iterations",
        "repetitions"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "capture_dom_counts": {
          "type": "boolean"
        },
        "capture_listener_tally": {
          "type": "boolean"
        },
        "capture_heap": {
          "type": "boolean"
        },
        "capture_wasm_capacity": {
          "type": "boolean",
          "description": "The high-water size of the wasm linear memory. A capacity diagnostic, never a live-usage figure."
        },
        "capture_wasm_live_allocation": {
          "type": "boolean",
          "description": "Live bytes and allocation count from a counting allocator. Layer B only, where the harness module owns the allocator."
        },
        "capture_frame_timing": {
          "type": "boolean"
        },
        "checkpoint_every": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "capture_dom_counts",
        "capture_listener_tally",
        "capture_heap",
        "capture_wasm_capacity",
        "capture_wasm_live_allocation",
        "capture_frame_timing"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "view": {
          "enum": ["unchanged", "expected", "ignored"]
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "dom_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["wall_ms"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "workload",
    "seed",
    "prng",
    "graph",
    "execution",
    "measurement",
    "limits"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "modes": {
                "contains": {
                  "const": "correctness"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["checkpoint"],
        "properties": {
          "measurement": {
            "required": ["checkpoint_every"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "const": "connector_rerouting"
          }
        }
      },
      "then": {
        "properties": {
          "graph": {
            "required": ["nodes", "edges"]
          }
        }
      }
    }
  ]
}
