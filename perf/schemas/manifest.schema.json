{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svg-dom-graph:perf:manifest:1",
  "title": "A workload manifest, as TOML converts to JSON",
  "description": "manifest.example.toml is an annotated instance. A result carries a complete copy of the manifest it ran. Unknown keys are rejected, so a misspelt option cannot be silently ignored.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workload": {
      "enum": ["scene_construction", "connector_rerouting", "scene_lifecycle", "interaction", "recovery"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "prng": {
      "const": "splitmix64"
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_degree": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["nodes"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": ["correctness", "performance", "recovery", "endurance"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "warmup_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "enum": ["sequential", "interleaved"]
        }
      },
      "required": ["modes", "warmup_iterations", "measurement_iterations", "repetitions"],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "capture_dom_counts": {
          "type": "boolean"
        },
        "capture_listener_tally": {
          "type": "boolean"
        },
        "capture_heap": {
          "type": "boolean"
        },
        "capture_wasm_capacity": {
          "type": "boolean",
          "description": "The high-water size of the wasm linear memory. A capacity diagnostic, never a live-usage figure."
        },
        "capture_wasm_live_allocation": {
          "type": "boolean",
          "description": "Live bytes and allocation count from a counting allocator. Layer B only, where the harness module owns the allocator."
        },
        "capture_frame_timing": {
          "type": "boolean"
        },
        "checkpoint_every": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "capture_dom_counts",
        "capture_listener_tally",
        "capture_heap",
        "capture_wasm_capacity",
        "capture_wasm_live_allocation",
        "capture_frame_timing"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "view": {
          "enum": ["unchanged", "expected", "ignored"]
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "description": "What a browser is driven with in the interaction workload, and at what scales of the view. Scales are in percent so that the manifest holds no floating-point number. The gestures are made once for each warm-up and measured iteration at each scale.",
      "properties": {
        "scales_percent": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 25,
            "maximum": 400
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "gestures": {
          "type": "array",
          "items": {
            "enum": ["drag", "pan", "wheel_zoom"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "step_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": ["scales_percent", "gestures", "steps", "step_pixels"],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "description": "The fault points of the recovery workload, each with what it is expected to leave behind, taken from the library's documented behaviour (perf/fault-contracts.json). undocumented means that nothing documents it: the runner records what it sees and reports a finding, and does not test against a guess.",
      "properties": {
        "target": {
          "enum": ["graph", "service_simulation"],
          "description": "What is broken. Absent means graph, as in every manifest from before this key. The service target is the discrete-event service simulator's controller and surface, with an executor of its own, and it has no graph."
        },
        "scenario": {
          "type": "string",
          "minLength": 1,
          "description": "The simulator scenario that is broken: a fixture name or the trace of a seed. Required for the service target and refused for the graph one."
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "enum": [
                  "node_construction",
                  "dom_transform",
                  "connector_update",
                  "label_update",
                  "drag_install",
                  "edge_construction",
                  "scheduled_frame",
                  "teardown",
                  "mid_drag_teardown",
                  "removed_host",
                  "service_data_node_construction",
                  "service_data_setter",
                  "service_overlay_write",
                  "service_control_aria",
                  "service_timer_request",
                  "service_frame_request",
                  "service_gallery_hidden",
                  "service_detached_before_draw",
                  "service_detached_during_draw",
                  "service_teardown_late_tick"
                ]
              },
              "expect": { "enum": ["nothing_committed", "partly_committed", "undocumented"] }
            },
            "required": ["point", "expect"],
            "additionalProperties": false
          }
        }
      },
      "required": ["points"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["target"],
            "properties": { "target": { "const": "service_simulation" } }
          },
          "then": {
            "required": ["scenario"],
            "properties": {
              "points": {
                "items": {
                  "properties": {
                    "point": {
                      "enum": [
                        "service_data_node_construction",
                        "service_data_setter",
                        "service_overlay_write",
                        "service_control_aria",
                        "service_timer_request",
                        "service_frame_request",
                        "service_gallery_hidden",
                        "service_detached_before_draw",
                        "service_detached_during_draw",
                        "service_teardown_late_tick"
                      ]
                    }
                  }
                }
              }
            }
          },
          "else": {
            "not": { "required": ["scenario"] },
            "properties": {
              "points": {
                "items": {
                  "properties": {
                    "point": {
                      "enum": [
                        "node_construction",
                        "dom_transform",
                        "connector_update",
                        "label_update",
                        "drag_install",
                        "edge_construction",
                        "scheduled_frame",
                        "teardown",
                        "mid_drag_teardown",
                        "removed_host"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "dom_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1
        },
        "live_growth_allowance_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "How many bytes live memory may grow by over the measured part of an endurance run before it fails its gate. Absent means none."
        }
      },
      "required": ["wall_ms"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "workload", "seed", "prng", "execution", "measurement", "limits"],
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Every workload has a graph, except the recovery workload aimed at the service simulator, which has none.",
      "if": {
        "required": ["recovery"],
        "properties": {
          "recovery": {
            "required": ["target"],
            "properties": { "target": { "const": "service_simulation" } }
          }
        }
      },
      "then": { "not": { "required": ["graph"] } },
      "else": { "required": ["graph"] }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "const": "recovery"
          }
        }
      },
      "then": {
        "required": ["recovery"]
      },
      "else": {
        "not": {
          "required": ["recovery"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "const": "interaction"
          }
        }
      },
      "then": {
        "required": ["interaction"]
      },
      "else": {
        "not": {
          "required": ["interaction"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "modes": {
                "contains": {
                  "const": "correctness"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["checkpoint"],
        "properties": {
          "measurement": {
            "required": ["checkpoint_every"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "const": "connector_rerouting"
          }
        }
      },
      "then": {
        "properties": {
          "graph": {
            "required": ["nodes", "edges"]
          }
        }
      }
    }
  ]
}
