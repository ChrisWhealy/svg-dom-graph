{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svg-dom-graph:perf:comparison:1",
  "title": "A comparison of a candidate collection of runs with a baseline collection",
  "description": "A separate artifact from a run result. The statistical unit is the repetition, and the inputs are result documents. An incompatible pair gets verdicts of not_comparable and no numbers. Fewer repetitions than the method requires gives diagnostic.",
  "$defs": {
    "interval": {
      "type": "object",
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": ["low", "high", "confidence"],
      "additionalProperties": false
    },
    "side": {
      "type": "object",
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "samples_per_repetition": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "median": {
          "type": "number"
        },
        "statistic_interval": {
          "$ref": "#/$defs/interval"
        },
        "between_run": {
          "type": "object",
          "properties": {
            "stddev": {
              "type": "number",
              "minimum": 0
            },
            "range": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["stddev", "range"],
          "additionalProperties": false
        },
        "within_run": {
          "type": "object",
          "properties": {
            "median_stddev": {
              "type": "number",
              "minimum": 0
            },
            "median_iqr": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["median_stddev", "median_iqr"],
          "additionalProperties": false
        },
        "outliers_flagged": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["repetitions", "samples_per_repetition", "median", "between_run", "within_run", "outliers_flagged"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "promotion": {
          "type": "object",
          "properties": {
            "promoted_at": {
              "type": "string",
              "format": "date-time"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "workload_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "environment_key": {
              "type": "string",
              "minLength": 1
            },
            "method_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["promoted_at", "commit", "workload_hash", "environment_key", "method_version"],
          "additionalProperties": false
        }
      },
      "required": ["git_sha", "manifest_sha256", "operation_stream_sha256", "run_ids", "promotion"],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "promotion": {
          "type": "object",
          "properties": {
            "promoted_at": {
              "type": "string",
              "format": "date-time"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "workload_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "environment_key": {
              "type": "string",
              "minLength": 1
            },
            "method_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["promoted_at", "commit", "workload_hash", "environment_key", "method_version"],
          "additionalProperties": false
        }
      },
      "required": ["git_sha", "manifest_sha256", "operation_stream_sha256", "run_ids"],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "comparable": {
          "type": "boolean"
        },
        "key": {
          "type": "object",
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1
            },
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "runner_class": {
              "type": "string",
              "minLength": 1
            },
            "browser_version": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)+$"
            },
            "protocol_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["os", "cpu", "runner_class", "browser_version", "protocol_version"],
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["comparable", "key"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparable": {
                "const": false
              }
            },
            "required": ["comparable"]
          },
          "then": {
            "required": ["reason"]
          }
        }
      ]
    },
    "method": {
      "type": "object",
      "properties": {
        "statistic": {
          "const": "ratio of repetition medians"
        },
        "bootstrap": {
          "const": "hierarchical: repetitions, then observations within each"
        },
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 1000
        },
        "bootstrap_seed": {
          "type": "integer",
          "minimum": 0
        },
        "ratio_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "minimum_repetitions_for_verdict": {
          "type": "integer",
          "minimum": 2
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "statistic",
        "bootstrap",
        "bootstrap_resamples",
        "bootstrap_seed",
        "ratio_tolerance",
        "confidence",
        "minimum_repetitions_for_verdict",
        "protocol_version"
      ],
      "additionalProperties": false
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": ["A", "B", "C"]
          },
          "statistic": {
            "enum": ["p50", "p95", "p99"]
          },
          "baseline": {
            "$ref": "#/$defs/side"
          },
          "candidate": {
            "$ref": "#/$defs/side"
          },
          "ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ratio_interval": {
            "$ref": "#/$defs/interval"
          },
          "verdict": {
            "enum": ["regression", "improvement", "no_material_change", "inconclusive", "diagnostic", "not_comparable"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["metric", "layer", "statistic", "verdict"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["regression", "improvement", "no_material_change", "inconclusive"]
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "required": ["baseline", "candidate", "ratio", "ratio_interval"]
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["inconclusive", "diagnostic", "not_comparable"]
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "required": ["reason"]
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "diagnostic"
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "required": ["baseline", "candidate"],
              "not": {
                "anyOf": [
                  {
                    "required": ["ratio_interval"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "not_comparable"
                }
              },
              "required": ["verdict"]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": ["ratio"]
                  },
                  {
                    "required": ["ratio_interval"]
                  },
                  {
                    "required": ["baseline"]
                  },
                  {
                    "required": ["candidate"]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": ["schema_version", "generated_at", "baseline", "candidate", "compatibility", "method", "comparisons"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "compatibility": {
            "properties": {
              "comparable": {
                "const": false
              }
            },
            "required": ["comparable"]
          }
        },
        "required": ["compatibility"]
      },
      "then": {
        "properties": {
          "comparisons": {
            "items": {
              "properties": {
                "verdict": {
                  "const": "not_comparable"
                }
              }
            }
          }
        }
      }
    }
  ]
}
