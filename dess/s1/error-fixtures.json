{
  "DUP-SCRIPT": {
    "why": "two scripted arrivals share a key, so a cancel would reach the second job and leave the first",
    "config": {
      "servers": 1,
      "queueCapacity": 2,
      "maxAttempts": 2,
      "deferralCap": 4
    },
    "script": [
      {
        "kind": "arrive",
        "at": 0,
        "key": "X",
        "priority": 1,
        "durations": [10],
        "deadline": 50
      },
      {
        "kind": "arrive",
        "at": 1,
        "key": "X",
        "priority": 1,
        "durations": [3],
        "deadline": 50
      },
      {
        "kind": "cancel",
        "at": 2,
        "key": "X"
      }
    ],
    "expect": {
      "outcome": "error",
      "kind": "invalid",
      "message": "the arrival key X is used more than once"
    }
  },
  "DUP-GENERATED": {
