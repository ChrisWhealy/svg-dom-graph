      "deferralCap": 4,
      "arrivals": 5,
      "gap": [1, 2],
      "highPercent": 50,
      "duration": [1, 3],
      "slack": [5, 9],
      "cancelPercent": 0,
      "cancelAfter": [1, 2],
      "outage": {
        "first": [1, 2],
        "length": [1, 2],
        "spacing": [1, 2]
      }
    },
    "script": [
      {
        "kind": "arrive",
        "at": 0,
        "key": "g0",
        "priority": 1,
        "durations": [3],
        "deadline": 50
      }
    ],
    "expect": {
      "outcome": "error",
      "kind": "invalid",
      "message": "the arrival key g0 is one that the generator uses"
    }
  },
