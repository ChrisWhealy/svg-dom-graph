      "cols": 5,
      "per_row": 0,
      "hub_cols": 0,
      "hub_percent": 0,
      "label_len": 12,
      "cells": 3,
      "updates": 2,
      "steps": 2
    },
    "budget": {
      "max_nodes": 1000000000000000,
      "max_edges": 1000000000000000,
      "max_degree": 1000000000000000,
      "max_cells_per_node": 1000000000000000,
      "max_total_cells": 1000000000000000,
      "max_label_len": 1000000000000000,
